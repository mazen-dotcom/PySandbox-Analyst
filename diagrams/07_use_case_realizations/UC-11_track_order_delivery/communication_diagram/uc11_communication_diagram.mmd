    SH["Shipment<br/>«entity» (Domain Layer)"]
    GR["GoodsReceipt<br/>«entity» (Domain Layer)"]
    DD["DeliveryDiscrepancy<br/>«entity» (Domain Layer)"]
    POE["PurchaseOrder<br/>«entity» (Domain Layer)"]
    SPR["SupplierPerformanceReview<br/>«entity» (Domain Layer)"]
    SHDA["ShipmentDA<br/>«dataAccess» (Data Access Layer)"]
    GRDA["GoodsReceiptDA<br/>«dataAccess» (Data Access Layer)"]
    DDDA["DeliveryDiscrepancyDA<br/>«dataAccess» (Data Access Layer)"]
    DB[("Database")]

    LC -- "1: openTrackOrderDelivery()" --> OTW
    OTW -- "2: getActiveOrders()" --> DH
    DH -- "3: findActiveShipments()" --> SHDA
    SHDA -- "4: SELECT active orders" --> DB
    LC -- "5: selectOrder(orderId)" --> OTW
    OTW -- "6: getOrderDetails(orderId)" --> DH
    DH -- "7: getTrackingStatus(orderId)" --> SH
    LC -- "8: updateShipmentProgress(status, date)" --> OTW
    OTW -- "9: recordShipmentProgress(status, date)" --> DH
    DH -- "10: updateProgress(status, date)" --> SH
    WH -- "11: confirmReceipt(quantities, inspection)" --> OTW
    OTW -- "12: recordReceipt(orderId, receipt)" --> DH
    DH -- "13: new GoodsReceipt(orderId, quantities)" --> GR
    DH -- "14: save(goodsReceipt)" --> GRDA
    DH -- "15: setStatus(Delivered)" --> SH
    DH -- "16: updateOrderStatus(Received)" --> POE
    DH -- "17: new DeliveryDiscrepancy(type, quantity)" --> DD
    DH -- "18: save(discrepancy)" --> DDDA
    DH -- "19: setRevisedDate(date)" --> SH
    DH -- "20: addVerifiedOutcome(orderId, outcome)" --> SPR

