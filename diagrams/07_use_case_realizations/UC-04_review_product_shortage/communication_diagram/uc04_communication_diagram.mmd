    PDA -- "4: SELECT products with reorder levels" --> DB
    RH -- "5: findStockByProduct()" --> IDA
    IDA -- "6: SELECT on-hand, reserved, available" --> DB
    RH -- "7: calculateAvailableStock()" --> INV
    RH -- "8: calculateShortage(requiredQuantity)" --> SR
    RH -- "9: generateShortageReport()" --> SR
    SCM -- "10: reviewShortageReport()" --> SRW
    SRW -- "11: reviewShortage(report)" --> RH
    RH -- "12: reviewShortage()" --> SR

