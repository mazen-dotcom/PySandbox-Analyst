flowchart TB
    SCM(["Supply Chain Manager<br/>«actor»"])
    WH(["Warehouse Department<br/>«actor»"])
    SRW["ShortageReportWindow<br/>«view» (View Layer)"]
    RH["ReviewHandler<br/>«controller» (Domain Layer)"]
    INV["Inventory<br/>«entity» (Domain Layer)"]
    SR["ShortageReport<br/>«entity» (Domain Layer)"]
    PDA["ProductDA<br/>«dataAccess» (Data Access Layer)"]
    IDA["InventoryDA<br/>«dataAccess» (Data Access Layer)"]
    DB[("Database")]

    SCM -- "1: openReviewProductShortage()" --> SRW
