flowchart TB
    USR(["Authorized System User<br/>«actor»"])
    LW["LoginWindow<br/>«view» (View Layer)"]
    UH["UserHandler<br/>«controller» (Domain Layer)"]
    US["User<br/>«entity» (Domain Layer)"]
    RO["Role<br/>«entity» (Domain Layer)"]
    UDA["UserDA<br/>«dataAccess» (Data Access Layer)"]
    DB[("Database")]

    USR -- "1: selectLogIn()" --> LW
    USR -- "2: enterCredentials(username, password)" --> LW
    LW -- "3: login(username, password)" --> UH
    UH -- "4: findUserByUsername(username)" --> UDA
    UDA -- "5: SELECT user by username" --> DB
    UH -- "6: validateCredentials(password)" --> US
    UH -- "7: checkAccess()" --> RO
    UH -- "8: saveAuditLog(LOGIN_SUCCESS)" --> UDA
    UDA -- "9: INSERT audit log entry" --> DB
    UH -- "10: saveAuditLog(denied or failed attempt)" --> UDA

    classDef view fill:#ECECFF,stroke:#9370DB,color:#131300
    classDef ctrl fill:#FFFFDE,stroke:#aaaa33,color:#131300
    classDef ent fill:#E8F4E8,stroke:#3a7d3a,color:#131300
    classDef da fill:#FDE9E7,stroke:#b33a2e,color:#131300
    classDef db fill:#F2F2F2,stroke:#777777,color:#131300
    class LW view
    class UH ctrl
    class US,RO ent
    class UDA da
    class DB db
