    OCW -- "6: recordConfirmation(orderId, response)" --> OH
    OH -- "7: new DeliveryConfirmation(orderId, response)" --> DC
    OH -- "8: setAgreedDeliveryDate(date)" --> DC
    OH -- "9: setConfirmationStatus(Confirmed)" --> POE
    OH -- "10: save(deliveryConfirmation)" --> DCDA
    DCDA -- "11: INSERT availability and confirmed date" --> DB
    OH -- "12: recordShortfall(quantity)" --> DC
    OH -- "13: save(deliveryConfirmation)" --> DCDA
    OH -- "14: recordRevisedDate(date)" --> DC
    OH -- "15: setConfirmationStatus(Awaiting Confirmation)" --> POE

